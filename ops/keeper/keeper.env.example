# Draw Shapes keeper (web/scripts/keeper.mjs). Copy to /etc/draw-shapes/keeper.env (mode 600).
# Two independent keepers: different hosts, different RPC providers, different keys.
RPC_URLS=https://base-mainnet.provider-a.example,https://mainnet.base.org
# A dedicated hot key holding only gas money (~0.02 ETH). Never the admin Safe or guardian key.
KEEPER_KEY=
DEPLOYMENT=/opt/draw-shapes/deployments/8453.json
INTERVAL_MS=15000
HEALTH_PORT=9464
# Slack/Discord-compatible webhook for alerts (optional)
ALERT_WEBHOOK=
# Skip sends above this gas price (gwei); settle refunds basefee + tip from maintenance
MAX_GAS_GWEI=2
PRIORITY_GWEI=0.001
# Only on the key registered as Treasury.keeper (deploys protocol-owned liquidity daily)
POL_KEEPER=0
# Alert thresholds
CASH_MIN_ETH=0.15
# VRF subscription floor: about 2x the worst-case fulfilment at the lane's max gas price
# (Base 2 gwei lane: 0.02; Base Sepolia 30 gwei lane: 0.25). Below the worst case, words stop arriving.
VRF_MIN_ETH=0.02
